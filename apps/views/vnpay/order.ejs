<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title><%= title || 'Thanh toán' %></title>

        <!-- Bootstrap 5 -->
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet" />
        <!-- Bootstrap Icons -->
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
            rel="stylesheet" />

        <style>
            body {
                background: #f8f9fa;
            }
            .card {
                border-radius: 1rem;
            }
            .form-section {
                padding: 2rem;
            }
            .form-section h4 {
                margin-bottom: 1.5rem;
                font-weight: bold;
                color: #0d6efd;
            }
        </style>
    </head>
    <body>
        <%- include('layout'); %>
        <div class="container py-5">
            <div class="row justify-content-center">
                <div class="col-lg-6 col-md-8">
                    <div class="card shadow-sm">
                        <div class="card-body form-section">
                            <h4 class="text-center mb-4"><%= title ||
                                'Thanh toán' %></h4>
                            <form id="createOrder"
                                action="/order/create_payment_url"
                                method="POST">
                                <!-- Số tiền -->
                                <div class="mb-3">
                                    <label for="amount" class="form-label">Số
                                        tiền</label>
                                    <input
                                        type="number"
                                        class="form-control"
                                        id="amount"
                                        name="amount"
                                        placeholder="Nhập số tiền"
                                        value="<%= amount*1000 || 1000000 %>"
                                        required />
                                </div>

                                <!-- Phương thức thanh toán -->
                                <div class="mb-4">
                                    <label class="form-label">Phương thức thanh
                                        toán</label>
                                    <div class="form-check">
                                        <input
                                            class="form-check-input"
                                            type="radio"
                                            name="bankCode"
                                            id="vnbankPaymentMethod"
                                            value="VNBANK"
                                            checked />
                                        <label class="form-check-label"
                                            for="vnbankPaymentMethod">
                                            ATM - Tài khoản ngân hàng nội địa
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <input
                                            class="form-check-input"
                                            type="radio"
                                            name="bankCode"
                                            id="intcardPaymentMethod"
                                            value="INTCARD" />
                                        <label class="form-check-label"
                                            for="intcardPaymentMethod">
                                            Thẻ quốc tế
                                        </label>
                                    </div>
                                </div>

                                <!-- Ngôn ngữ -->
                                <div class="mb-4">
                                    <label class="form-label">Ngôn ngữ</label>
                                    <div class="form-check form-check-inline">
                                        <input
                                            class="form-check-input"
                                            type="radio"
                                            name="language"
                                            id="vnLanguage"
                                            value="vn"
                                            checked />
                                        <label class="form-check-label"
                                            for="vnLanguage">
                                            Tiếng Việt
                                        </label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input
                                            class="form-check-input"
                                            type="radio"
                                            name="language"
                                            id="enLanguage"
                                            value="en" />
                                        <label class="form-check-label"
                                            for="enLanguage">
                                            English
                                        </label>
                                    </div>
                                </div>

                                <!-- Nút submit -->
                                <div class="d-grid">
                                    <button type="submit"
                                        class="btn btn-primary btn-lg">
                                        <i class="bi bi-credit-card me-1"></i>
                                        Thanh toán
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bootstrap JS -->
        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>