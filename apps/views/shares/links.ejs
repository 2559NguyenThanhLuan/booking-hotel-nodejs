<script>
    document.addEventListener("DOMContentLoaded", function () {
        const checkinInput = document.getElementById("checkin");
        const checkoutInput = document.getElementById("checkout");
        const pricePerNight = parseFloat(document.getElementById("room").value);
        const amountInput = document.getElementById("amount"); 
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        function calculateTotalAmount() {
            const checkinDate = new Date(checkinInput.value);
            const checkoutDate = new Date(checkoutInput.value);
            checkinDate.setHours(0, 0, 0, 0);
            checkoutDate.setHours(0, 0, 0, 0);
            if (checkinDate < today) {
                alert("Ngày nhận phòng không được trước ngày hiện tại.");
                checkinInput.value = ""; 
                amountInput.value = null;
                return;
            } else if(checkinDate > checkoutDate){
                alert("Ngày trả phòng không được trước ngày nhận phòng.");
                checkoutInput.value = ""; 
                amountInput.value = null;
                return;
            }else if(checkinDate.getTime() === checkoutDate.getTime()) {
                alert("Ngày nhận phòng và ngày trả phòng không được giống nhau.");
                checkoutInput.value = ""; 
                amountInput.value = null;
                return;
            } else if (checkinDate && checkoutDate && checkoutDate > checkinDate) {
                const timeDifference = checkoutDate - checkinDate;
                const days = timeDifference / (1000 * 60 * 60 * 24); // Chuyển đổi từ milliseconds sang ngày
                const totalAmount = days * pricePerNight;

                // Hiển thị tổng tiền vào trường input
                amountInput.value = totalAmount.toLocaleString();
            } else {
                amountInput.value = null;
            }
        }

        checkinInput.addEventListener("change", calculateTotalAmount);
        checkoutInput.addEventListener("change", calculateTotalAmount);
    });
</script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
    var currentPath = window.location.pathname;
    var menuLinks = document.querySelectorAll(".navbar-nav .nav-link");

    menuLinks.forEach(function (link) {
        if (link.getAttribute("href") === currentPath) {
            menuLinks.forEach(l => l.classList.remove("active")); // Remove active from all
            link.classList.add("active"); // Add active to current page link
        }
    });
});



</script>
